<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sBillDate"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:text="@string/date"
        android:gravity="center_horizontal"
        android:textColor="@color/colorBlack"
        android:layout_marginStart="60dp"
        android:layout_marginLeft="60dp"
        android:padding="3dp"
        android:textSize="20sp"
         />


        <TextView
            android:id = "@+id/sTransactionNo"
            android:layout_width = "200dp"
            android:layout_height = "wrap_content"
            android:padding="3dp"
            android:gravity="center_horizontal"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="270dp"
            android:layout_marginLeft="270dp"
            android:text="@string/trans_no"
            android:textSize="20sp"
             />


        <TextView
        android:id = "@+id/noOfPoints"
        android:layout_width = "200dp"
        android:layout_height = "wrap_content"
        android:padding="3dp"
        android:gravity="center"
        android:layout_marginStart="550dp"
            android:layout_marginLeft="550dp"
            android:text="@string/points"
        android:textSize="20sp"
            android:textColor="@color/colorBlack"
            />

        <TextView
            android:id = "@+id/noOfDays"
            android:layout_width = "200dp"
            android:layout_height = "wrap_content"
            android:gravity="center"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="790dp"
            android:layout_marginLeft="790dp"
            android:text="@string/no_of_days"
            android:textSize="20sp"
             />



    </RelativeLayout>

</LinearLayout>
