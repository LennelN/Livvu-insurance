<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

        <TextView
            android:id = "@+id/sBillDate"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:text="@string/date"
            android:layout_marginStart="60dp"
            android:padding="3dp"
            android:textSize="20sp"
            android:textColor="@color/colorBlack"
            android:layout_marginLeft="60dp" />

        <TextView
            android:id = "@+id/sPhoneNo"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:text="@string/type"
            android:textSize="20sp"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:layout_marginStart="240dp"
            android:layout_marginLeft="240dp" />

        <TextView
            android:id = "@+id/sBillNo"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:text="@string/bill_no"
            android:layout_marginStart="460dp"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:textSize="20sp"
            android:layout_marginLeft="460dp" />


        <TextView
            android:id = "@+id/sName"
            android:layout_width = "280dp"
            android:layout_height = "match_parent"
            android:layout_marginStart="610dp"
            android:padding="3dp"
            android:gravity="start"
            android:textColor="@color/colorBlack"
            android:textSize="20sp"
            android:text="@string/name"
            android:layout_marginLeft="610dp" />

        <TextView
            android:id = "@+id/sPaid"
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:padding="3dp"
            android:layout_marginStart="900dp"
            android:textColor="@color/colorBlack"
            android:text="@string/credit"
            android:textSize="20sp"
            android:layout_marginLeft="900dp" />




    </RelativeLayout>

</LinearLayout>
