<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="80dp"
    android:background="@color/colorGreen"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/colorWhite"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/purchase_points_form"
                android:textColor="@color/colorBlack"
                android:textSize="20sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginStart="60dp"
                android:textSize="20sp"
                android:layout_below="@id/tvWelcomeMsg"
                android:textStyle="normal"
                android:textColor="@color/colorBlack"
                android:text="@string/ecocash"
                android:layout_marginLeft="60dp" />

            <TextView
                android:id="@+id/textView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_below="@id/textView"
                android:layout_marginTop="10dp"
                android:layout_marginStart="60dp"
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="@color/colorBlack"
                android:text="@string/airtime"
                android:layout_marginLeft="60dp" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_below="@id/textView1"
                android:layout_marginTop="10dp"
                android:layout_marginStart="60dp"
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="@color/colorBlack"
                android:text="@string/pay_credit_card"
                android:layout_marginLeft="60dp" />


            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_below="@id/textView2"
                android:layout_marginTop="10dp"
                android:layout_marginStart="60dp"
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="@color/colorBlack"
                android:text="@string/onemoney"
                android:layout_marginLeft="60dp" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_below="@id/textView3"
                android:layout_marginTop="10dp"
                android:layout_marginStart="60dp"
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="@color/colorBlack"
                android:text="@string/_5_telecash"
                android:layout_marginLeft="60dp" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_below="@id/textView4"
                android:layout_marginTop="10dp"
                android:layout_marginStart="60dp"
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="@color/colorBlack"
                android:text="@string/_5_paynow"
                android:layout_marginLeft="60dp" />


            <EditText
                android:id="@+id/etMenuChoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView5"
                android:textSize="20sp"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:ems="20"
                android:importantForAutofill="no"
                android:inputType="number" />

            <TextView
                android:id="@+id/tvSendHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etMenuChoice"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="540dp"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textSize="20sp"
                android:textColor="@color/colorCell"
                android:enabled="false"
                android:text="@string/send" />

            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etMenuChoice"
                android:layout_marginStart="200dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textSize="20sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:text="@string/cancel" />


        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

</RelativeLayout>