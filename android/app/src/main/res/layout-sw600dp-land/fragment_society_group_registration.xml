<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="50dp"
    android:gravity="center"
    android:background="@color/colorGreen"
    android:layout_gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@color/colorWhite"
            android:gravity="center">
            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:textSize="20sp"
                android:text="@string/welcome_to_phila_registration_form"
                 />


            <EditText
                android:id="@+id/etName"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_marginTop="80dp"
                android:inputType="textCapWords"
                android:textColorHint="@color/colorBlack"
                android:hint="@string/name2"
                android:textSize="20sp"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etLicenceNo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etName"
                android:inputType="textCapWords"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:textSize="20sp"
                android:hint="@string/identification_number"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_below="@id/etLicenceNo"
                android:layout_alignParentStart="true"
                android:layout_marginTop="10dp"
                android:textColorHint="@color/colorBlack"
                android:inputType="textCapWords"
                android:textSize="20sp"
                android:hint="@string/soc_desc"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etDescription"
                android:layout_marginTop="10dp"
                android:textColorHint="@color/colorBlack"
                android:inputType="textCapWords"
                android:textSize="20sp"
                android:hint="@string/society_address"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etAddress"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:inputType="phone"
                android:textSize="20sp"
                android:importantForAutofill="no"
                android:hint="@string/phone_number"
                android:layout_alignParentLeft="true" />


            <EditText
                android:id="@+id/etPassword"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etPhoneNumber"
                android:layout_marginTop="10dp"
                android:textColorHint="@color/colorBlack"
                android:textSize="20sp"
                android:inputType="numberPassword"
                android:hint="@string/password_hint"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etPassword"
                android:layout_marginTop="10dp"
                android:inputType="numberPassword"
                android:textColorHint="@color/colorBlack"
                android:imeOptions="actionNext"
                android:orientation="horizontal"
                android:textSize="20sp"
                android:nextFocusDown="@id/country_Name"
                android:hint="@string/confirm_password"
                android:layout_alignParentLeft="true" />

            <TextView
                android:id="@+id/select_country"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textColor="@color/colorBlack"
                android:text="@string/select_country"
                android:layout_below="@id/etConfirmPassword"
                android:layout_marginTop="20dp"
                android:textSize="20sp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true" />

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/country_Name"
                android:layout_height="50dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginTop="20dp"
                android:layout_alignParentEnd="true"
                android:spinnerMode="dropdown"
                android:backgroundTint="@color/colorBlack"
                android:layout_below="@id/etConfirmPassword"
                android:layout_toEndOf="@id/select_country"
                android:layout_toRightOf="@id/select_country"
                android:layout_alignParentRight="true" />

            <TextView
                android:id="@+id/etRegion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_below="@id/country_Name"
                android:layout_marginTop="20dp"
                android:textSize="20sp"
                android:textColor="@color/colorBlack"
                android:text="@string/soc_group_region"
                android:layout_alignParentLeft="true" />

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/region_desc"
                android:layout_height="50dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginTop="20dp"
                android:layout_alignParentEnd="true"
                android:spinnerMode="dropdown"
                android:backgroundTint="@color/colorBlack"
                android:imeOptions="actionNext"
                android:orientation="horizontal"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_below="@id/country_Name"
                android:layout_toEndOf="@id/etRegion"
                android:layout_alignParentRight="true"
                android:layout_toRightOf="@id/etRegion" />


            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/region_desc"
                android:layout_marginTop="50dp"
                android:layout_marginStart="140dp"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textSize="20sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:layout_marginBottom="20dp"
                android:text="@string/cancel"
                android:layout_marginLeft="140dp" />

            <TextView
                android:id="@+id/tvRegisterHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/region_desc"
                android:layout_marginStart="480dp"
                android:textColor="@color/colorCell"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:layout_marginTop="50dp"
                android:textSize="20sp"
                android:enabled="false"
                android:text="@string/register"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="480dp" />
        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>