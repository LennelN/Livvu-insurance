<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="80dp"
    android:layout_gravity="center"
    android:background="@color/colorGreen"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:id="@+id/relativeLayout1"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_gravity="center"
        app:cardCornerRadius="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorWhite"
        android:gravity="center">


        <TextView
            android:id="@+id/tvWelcomeMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:text="@string/activate_merchant_user_form"
            android:textColor="@color/colorBlack"
            android:textSize="20sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvUserLoginID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvWelcomeMsg"
            android:layout_marginTop="80dp"
            android:text="@string/merchant_phone_number"
            android:textColor="@color/colorBlack"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/etUserLoginID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvWelcomeMsg"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginStart="10dp"
            android:textSize="20sp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="75dp"
            android:layout_toEndOf="@id/tvUserLoginID"
            android:layout_toRightOf="@id/tvUserLoginID"
            android:backgroundTint="@color/colorBlack"
            android:gravity="center"
            android:inputType="textCapWords"
            android:textColor="@color/colorBlack"
            android:textColorHint="@color/colorBlack" />


        <TextView
            android:id="@+id/select_country"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/select_country"
            android:textColor="@color/colorBlack"
            android:layout_below="@id/etUserLoginID"
            android:layout_marginTop="30dp"
            android:textSize="20sp"
            android:layout_alignParentStart="true"
            />

        <Spinner
            android:layout_width="match_parent"
            android:id="@+id/country_Name"
            android:layout_height="80dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="20dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="@color/colorBlack"
            android:spinnerMode="dropdown"
            android:layout_below="@id/etUserLoginID"
            android:layout_toEndOf="@id/select_country"
            />


        <Button
            android:id="@+id/btnSend"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/country_Name"
            android:layout_marginStart="540dp"
            android:layout_marginTop="30dp"
            android:textSize="20sp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button"
            android:enabled="false"
            android:text="@string/send"
            android:textColor="@color/colorCell" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/country_Name"
            android:layout_marginStart="200dp"
            android:textSize="20sp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/colorBlack"

            />

    </RelativeLayout>
    </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>