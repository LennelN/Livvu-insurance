<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sBillDate"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:text="@string/date"
        android:gravity="center_horizontal"
        android:textColor="@color/colorBlack"
        android:layout_marginStart="70dp"
        android:layout_marginLeft="70dp"
        android:padding="3dp"
        android:textSize="20sp"
         />


        <TextView
            android:id = "@+id/sMerchantName"
            android:layout_width = "340dp"
            android:layout_height = "wrap_content"
            android:padding="3dp"
            android:gravity="center_horizontal"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="180dp"
            android:layout_marginLeft="180dp"
            android:text="@string/name"
            android:textSize="20sp"
             />


        <TextView
        android:id = "@+id/sBillNo"
        android:layout_width = "200dp"
        android:layout_height = "wrap_content"
        android:padding="3dp"
        android:gravity="center"
        android:layout_marginStart="520dp"
            android:layout_marginLeft="520dp"
            android:text="@string/bill_no"
        android:textSize="20sp"
            android:textColor="@color/colorBlack"
            />

        <TextView
            android:id = "@+id/sAmount"
            android:layout_width = "200dp"
            android:layout_height = "wrap_content"
            android:gravity="center"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="790dp"
            android:layout_marginLeft="790dp"
            android:text="@string/amount"
            android:textSize="20sp"
             />



    </RelativeLayout>

</LinearLayout>
