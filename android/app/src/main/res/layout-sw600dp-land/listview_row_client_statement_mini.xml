<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

        <TextView
            android:id = "@+id/sBillDate"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:text="@string/date"
            android:layout_marginStart="20dp"
            android:padding="3dp"
            android:textSize="20sp"
            android:textColor="@color/colorBlack"
            android:layout_marginLeft="20dp" />

        <TextView
            android:id = "@+id/sCode"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:text="@string/type"
            android:textSize="20sp"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:layout_marginStart="180dp"
            android:layout_marginLeft="180dp" />

        <TextView
            android:id = "@+id/sMerchantName"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:text="@string/ph_no"
            android:layout_marginStart="380dp"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:textSize="20sp"
            android:layout_marginLeft="380dp" />


        <TextView
            android:id = "@+id/noOfPoints"
            android:layout_width = "140dp"
            android:layout_height = "match_parent"
            android:layout_marginStart="590dp"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:textAlignment="center"
            android:textSize="20sp"
            android:text="@string/debit"
            android:layout_marginLeft="590dp" />

        <TextView
            android:id = "@+id/noOfPointsPaid"
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:padding="3dp"
            android:layout_marginStart="740dp"
            android:textAlignment="center"
            android:textColor="@color/colorBlack"
            android:text="@string/credit"
            android:textSize="20sp"
            android:layout_marginLeft="740dp" />




    </RelativeLayout>

</LinearLayout>
