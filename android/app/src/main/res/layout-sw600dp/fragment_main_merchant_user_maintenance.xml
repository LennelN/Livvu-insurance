<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="50dp"
    android:background="@color/colorGreen"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:layout_gravity="center"
            android:gravity="center">
                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="30dp"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/colorBlack"
                    android:layout_centerHorizontal="true"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvMainMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:textSize="20sp"
                    android:layout_marginTop="80dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginStart="40dp"
                    android:layout_below="@+id/tvWelcomeMsg"
                    android:text="@string/please_select"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="40dp" />


                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="15dp"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/_1_create_merchant_user_account"
                    android:layout_below="@+id/tvMainMenu"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="40dp"
                    android:layout_alignLeft="@+id/tvWelcomeMsg"
                    android:layout_marginLeft="40dp"
                    android:layout_alignParentLeft="true" />


                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="15dp"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/_2_deactivate_merchant_user_account"
                    android:layout_below="@+id/textView2"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="40dp"
                    android:layout_alignLeft="@+id/tvWelcomeMsg"
                    android:layout_marginLeft="40dp"
                    android:layout_alignParentLeft="true" />


                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="15dp"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/_3_activate_merchant_user_account"
                    android:layout_below="@+id/textView3"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="40dp"
                    android:layout_alignLeft="@+id/tvWelcomeMsg"
                    android:layout_marginLeft="40dp"
                    android:layout_alignParentLeft="true" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="15dp"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/_4_activate_merchant_user_reset_password"
                    android:layout_below="@+id/textView4"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="40dp"
                    android:layout_alignLeft="@+id/tvWelcomeMsg"
                    android:layout_marginLeft="40dp"
                    android:layout_alignParentLeft="true" />


                <EditText
                    android:id="@+id/etMenuChoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView5"
                    android:textSize="20sp"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/colorBlack"
                    android:ems="20"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginTop="50dp"
                    android:layout_marginStart="290dp"
                    android:textSize="20sp"
                    android:enabled="false"
                    android:textAlignment="center"
                    android:layout_marginBottom="50dp"
                    android:background="@drawable/rounded_button"
                    android:textColor="@color/colorCell"
                    android:text="@string/send"
                    />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginStart="80dp"
                    android:textStyle="normal"
                    android:layout_marginTop="50dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:layout_marginBottom="50dp"
                    android:textSize="20sp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/cancel"
                     />


            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        </ScrollView>
</RelativeLayout>