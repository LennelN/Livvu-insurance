<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:padding="50dp"
    android:layout_gravity="center"
    android:background="@color/colorGreen"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:id="@+id/relativeLayout1">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:layout_gravity="center"
            android:gravity="center">


            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_centerHorizontal="true"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorBlack"
                android:text="@string/deactivate_user_form"
                 />



            <TextView
                android:id="@+id/tvUserLoginID"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/user_login_id"
                android:layout_below="@id/tvWelcomeMsg"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="20sp"
                />

            <EditText
                android:id="@+id/etUserLoginID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:layout_toRightOf="@id/tvUserLoginID"
                android:layout_below="@id/tvWelcomeMsg"
                android:layout_alignParentRight="true"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_marginLeft="10dp"
                android:textSize="20sp"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvUserLoginID" />

            <TextView
                android:id="@+id/select_country"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/select_country"
                android:textColor="@color/colorBlack"
                android:layout_below="@id/etUserLoginID"
                android:layout_marginTop="30dp"
                android:textSize="20sp"
                android:layout_alignParentStart="true"
                />

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/country_Name"
                android:layout_height="80dp"
                android:layout_marginTop="0dp"
                android:layout_marginStart="20dp"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/colorBlack"
                android:spinnerMode="dropdown"
                android:layout_below="@id/etUserLoginID"
                android:layout_toEndOf="@id/select_country"
                />

            <TextView
                android:id="@+id/tvReasonUserDeactivated"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/reason_user_deactivated2"
                android:layout_below="@id/country_Name"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="20sp"
                />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="#000"
                android:layout_marginBottom="0dp"
                android:padding="10dp"
                android:textSize="20sp"
                android:layout_toRightOf="@id/tvReasonUserDeactivated"
                android:layout_below="@+id/country_Name"
                android:id="@+id/reason_TextInputLayout"
                android:layout_toEndOf="@id/tvReasonUserDeactivated">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReasonUserDeactivated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="true"
                android:maxLength="50"
                android:height="100dp"
                android:gravity="top"
                android:textSize="20sp"
                android:layout_marginTop="15dp"
                android:backgroundTint="@color/colorBlack"
                android:textColor="#000"
                 />
            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/btnSend"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/reason_TextInputLayout"
                android:layout_marginStart="290dp"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="50dp"
                android:background="@drawable/rounded_button"
                android:enabled="false"
                android:text="@string/send"
                android:textSize="20sp"
                android:textColor="@color/colorCell" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="50dp"
                android:layout_below="@id/reason_TextInputLayout"
                android:text="@string/cancel"
                android:background="@drawable/rounded_button"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="@color/colorBlack"

                />

        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>