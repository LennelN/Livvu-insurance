<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sBillDate"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:padding="2dp"
        android:text="@string/date"
        android:textSize="20sp"
        android:textColor="@color/colorBlack"
        android:layout_marginLeft="110dp"
         />

    <TextView
        android:id = "@+id/sMerchantName"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_marginStart="120dp"
        android:textColor="@color/colorBlack"
        android:padding="1dp"
        android:textSize="20sp"
        android:text="@string/phone"
        android:layout_marginLeft="120dp"
         />


        <TextView
            android:id = "@+id/totalPrice"
            android:layout_width = "120dp"
            android:layout_height = "match_parent"
            android:layout_marginStart="250dp"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:text="@string/bill_no"
            android:textSize="20sp"
            android:layout_marginLeft="250dp" />

    <TextView
        android:id = "@+id/noOfPoints"
        android:layout_width = "100dp"
        android:layout_height = "match_parent"
        android:padding="3dp"
        android:layout_marginStart="390dp"
        android:textColor="@color/colorBlack"
        android:text="@string/points"
        android:textSize="20sp"
        android:layout_marginLeft="390dp" />

        <TextView
            android:id = "@+id/noOfDays"
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="500dp"
            android:text="@string/no_of_days"
            android:textSize="20sp"
            android:layout_marginLeft="500dp" />



    </RelativeLayout>

</LinearLayout>
