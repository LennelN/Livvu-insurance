<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:background="@color/colorCell"
    android:layout_height="match_parent">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginLeft="0dp"
            android:text="@string/total"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:id="@+id/total"
            android:textColor="@color/colorWhite"
            />

        <TextView
            android:id="@+id/tv120days"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/total"
            android:layout_marginStart="0dp"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="0dp"
            android:padding="0dp"
            android:text="@string/days120"
            android:textColor="@color/colorWhite"
            android:textSize="16sp" />

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="70dp"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="5dp"
            android:text="@string/days90"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="normal"
            android:layout_below="@id/total"
            android:padding="0dp"
            android:id="@+id/tv90days"
            android:textColor="@color/colorWhite"
            />

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="140dp"
            android:text="@string/days60"
            android:textSize="16sp"
            android:textStyle="normal"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_below="@id/total"
            android:padding="0dp"
            android:id="@+id/tv60days"
            android:textColor="@color/colorWhite"
            android:layout_marginLeft="140dp" />

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="210dp"
            android:layout_marginLeft="210dp"
            android:text="@string/days30"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="normal"
            android:layout_marginTop="5dp"
            android:layout_below="@id/total"
            android:padding="0dp"
            android:id="@+id/tv30days"
            android:textColor="@color/colorWhite"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="280dp"
            android:layout_marginLeft="280dp"
            android:text="@string/owing"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="normal"
            android:layout_marginTop="5dp"
            android:layout_below="@id/total"
            android:padding="0dp"
            android:id="@+id/current"
            android:textColor="@color/colorWhite"
            />


        <TextView
            android:id="@+id/footer_debit"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="140dp"
            android:gravity="end"
            android:padding="3dp"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/footer_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="300dp"
            android:gravity="end"
            android:padding="3dp"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginLeft="0dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_below="@id/tv120days"
            android:padding="1dp"
            android:textAlignment="center"
            android:id="@+id/footer_balance_120days"
            android:textColor="@color/colorWhite"
            />

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="70dp"
            android:layout_marginLeft="70dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_below="@id/tv120days"
            android:padding="1dp"
            android:textAlignment="center"
            android:id="@+id/footer_balance_90days"
            android:textColor="@color/colorWhite"
            />

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="140dp"
            android:layout_marginLeft="140dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_below="@id/tv120days"
            android:padding="1dp"
            android:id="@+id/footer_balance_60days"
            android:textColor="@color/colorWhite"
            />

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="210dp"
            android:layout_marginLeft="210dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_below="@id/tv120days"
            android:padding="1dp"
            android:textAlignment="center"
            android:id="@+id/footer_balance_30days"
            android:textColor="@color/colorWhite"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="280dp"
            android:layout_marginLeft="280dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_below="@id/tv120days"
            android:padding="1dp"
            android:textAlignment="center"
            android:id="@+id/footer_balance"
            android:textColor="@color/colorWhite"
            />


        <Button
            android:id="@+id/cancel"
            android:layout_width="fill_parent"
            android:layout_below="@id/footer_balance"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginTop="10dp"
            android:background="@color/colorGreen"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:text="@string/cancel"
            android:layout_marginLeft="0dp" />

    </RelativeLayout>
</LinearLayout>