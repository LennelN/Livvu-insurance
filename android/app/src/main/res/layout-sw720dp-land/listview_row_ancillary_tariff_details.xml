<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sCode"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:text="@string/date"
       android:gravity="center"
        android:layout_marginStart="10dp"
        android:padding="3dp"
        android:textSize="30sp"
        android:textColor="@color/colorBlack"
        android:layout_marginLeft="10dp"
        />

        <TextView
            android:id = "@+id/sDescription"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:text="@string/code"
            android:textSize="30sp"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="170dp"
            android:layout_marginLeft="170dp" />

    <TextView
        android:id = "@+id/sPrice"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:text="@string/desc"
        android:layout_marginStart="480dp"
        android:padding="3dp"
        android:gravity="center_horizontal"
        android:textColor="@color/colorBlack"
        android:textSize="30sp"
        android:layout_marginLeft="480dp"
         />


        <TextView
            android:id = "@+id/sCategory"
            android:layout_width = "240dp"
            android:layout_height = "match_parent"
            android:layout_marginStart="750dp"
            android:padding="3dp"
            android:textSize="30sp"
            android:textColor="@color/colorBlack"
            android:text="@string/debit"
            android:layout_marginLeft="750dp" />

    <TextView
        android:id = "@+id/sType"
        android:layout_width = "match_parent"
        android:layout_height = "match_parent"
        android:padding="3dp"
        android:layout_marginStart="1000dp"
        android:textColor="@color/colorBlack"
        android:text="@string/credit"
        android:textSize="30sp"
        android:layout_marginLeft="1000dp" />




    </RelativeLayout>

</LinearLayout>
