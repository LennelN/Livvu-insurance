<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="100dp"
    android:gravity="center"
    android:background="@color/colorGreen"
    android:layout_gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:background="@color/colorWhite"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            >


            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:text="@string/create_ancilliary_tariff_form"
                android:textColor="@color/colorBlack"
                android:textSize="30sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/etTariffCode"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_marginTop="100dp"
                android:inputType="phone"
                android:textSize="30sp"
                android:textColorHint="@color/colorBlack"
                android:hint="@string/enter_tariff_code"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etTariffDescription"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapWords"
                android:layout_below="@id/etTariffCode"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:textSize="30sp"
                android:hint="@string/enter_tariff_description"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etTariffCategory"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapWords"
                android:layout_below="@id/etTariffDescription"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:textSize="30sp"
                android:hint="@string/enter_tariff_category"
                android:layout_alignParentLeft="true" />


            <EditText
                android:id="@+id/etTariffPrice"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etTariffCategory"
                android:layout_marginTop="10dp"
                android:textSize="30sp"
                android:textColorHint="@color/colorBlack"
                android:inputType="numberDecimal"
                android:hint="@string/enter_tariff_price"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etTariffType"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etTariffPrice"
                android:layout_marginTop="10dp"
                android:textSize="30sp"
                android:textColorHint="@color/colorBlack"
                android:inputType="textCapWords"
                android:hint="@string/enter_tariff_type"
                android:layout_alignParentLeft="true" />


            <TextView
                android:id="@+id/select_country"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/select_country"
                android:textColor="@color/colorBlack"
                android:layout_below="@id/etTariffType"
                android:layout_marginTop="15dp"
                android:textSize="30sp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true" />

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/country_Name"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="50dp"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/colorBlack"
                android:spinnerMode="dropdown"
                android:layout_below="@id/etTariffType"
                android:layout_toEndOf="@id/select_country"
                android:layout_marginLeft="50dp"
                android:layout_alignParentRight="true"
                android:layout_toRightOf="@id/select_country" />



            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/country_Name"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:layout_marginStart="240dp"
                android:textSize="30sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:text="@string/cancel"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                 />

            <TextView
                android:id="@+id/tvSendHere"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/country_Name"
                android:layout_marginStart="640dp"
                android:layout_marginTop="30dp"
                android:enabled="false"
                android:text="@string/send"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:layout_marginBottom="30dp"
                android:textColor="@color/colorCell"
                android:textSize="30sp"
                 />

        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>