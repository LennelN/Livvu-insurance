<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sBillDate"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:text="@string/date"
        android:layout_marginStart="20dp"
        android:padding="3dp"
        android:textSize="30sp"
        android:textColor="@color/colorBlack"
        android:layout_marginLeft="20dp"
        />

        <TextView
            android:id = "@+id/sCode"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:text="@string/code"
            android:textSize="30sp"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="260dp"
            android:layout_marginLeft="260dp" />

    <TextView
        android:id = "@+id/sDescription"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:text="@string/desc"
        android:layout_marginStart="420dp"
        android:padding="3dp"
        android:textColor="@color/colorBlack"
        android:textSize="30sp"
        android:gravity="center_horizontal"
        android:layout_marginLeft="420dp"
         />


        <TextView
            android:id = "@+id/sNo"
            android:layout_width = "200dp"
            android:layout_height = "match_parent"
            android:layout_marginStart="850dp"
            android:padding="3dp"
            android:textSize="30sp"
            android:textColor="@color/colorBlack"
            android:text="@string/debit"
            android:layout_marginLeft="850dp" />

    <TextView
        android:id = "@+id/sDoctor"
        android:layout_width = "match_parent"
        android:layout_height = "match_parent"
        android:padding="3dp"
        android:layout_marginStart="1060dp"
        android:textColor="@color/colorBlack"
        android:text="@string/credit"
        android:textSize="30sp"
        android:layout_marginLeft="1060dp" />




    </RelativeLayout>

</LinearLayout>
