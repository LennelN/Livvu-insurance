<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sBillDate"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:text="@string/date"
       android:gravity="start"
        android:layout_marginStart="0dp"
        android:padding="3dp"
        android:textSize="30sp"
        android:textColor="@color/colorBlack"
        android:layout_marginLeft="0dp"
        />

        <TextView
            android:id = "@+id/sCode"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:text="@string/code"
            android:textSize="30sp"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="250dp"
            android:layout_marginLeft="250dp" />

    <TextView
        android:id = "@+id/sMerchantName"
        android:layout_width="370dp"
        android:layout_height="match_parent"
        android:text="@string/desc"
        android:layout_marginStart="400dp"
        android:padding="3dp"
        android:gravity="center"
        android:textColor="@color/colorBlack"
        android:textSize="30sp"
        android:layout_marginLeft="400dp"
         />


        <TextView
            android:id = "@+id/noOfPoints"
            android:layout_width = "200dp"
            android:layout_height = "match_parent"
            android:layout_marginStart="800dp"
            android:padding="3dp"
            android:gravity="center"
            android:textSize="30sp"
            android:textColor="@color/colorBlack"
            android:text="@string/debit"
            android:layout_marginLeft="800dp" />

    <TextView
        android:id = "@+id/noOfPointsPaid"
        android:layout_width = "match_parent"
        android:layout_height = "match_parent"
        android:padding="3dp"
        android:layout_marginStart="1040dp"
        android:textColor="@color/colorBlack"
        android:text="@string/credit"
        android:textSize="30sp"
        android:gravity="center"
        android:layout_marginLeft="1040dp" />




    </RelativeLayout>

</LinearLayout>
