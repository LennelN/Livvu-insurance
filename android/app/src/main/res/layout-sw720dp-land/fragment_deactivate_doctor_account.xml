<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:background="@color/colorGreen"
    android:padding="100dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:id="@+id/relativeLayout1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:background="@color/colorWhite"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            >
        <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/deactivate_doctor_form"
                android:textColor="@color/colorBlack"
                android:textSize="30sp"
                android:textStyle="bold" />



            <TextView
                android:id="@+id/tvDoctorPhone"
                android:layout_height="wrap_content"
                android:layout_width="350dp"
                android:layout_below="@id/tvWelcomeMsg"
                android:text="@string/select_doctor_phone_no"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="40dp"
                android:textSize="30sp"
                />

            <Spinner
                android:id="@+id/etDoctorPhone"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_below="@id/tvWelcomeMsg"
                android:layout_marginStart="0dp"
                android:layout_marginTop="15dp"
                android:layout_toEndOf="@id/tvDoctorPhone"
                android:backgroundTint="@color/colorBlack"
                android:spinnerMode="dropdown" />



            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/doctors_name"
                android:layout_below="@id/etDoctorPhone"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="30sp"
                />

            <EditText
                android:id="@+id/etDoctorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:enabled="false"
                android:inputType="textCapCharacters"
                android:textSize="30sp"
                android:layout_below="@id/etDoctorPhone"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_marginLeft="10dp"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorName" />


            <TextView
                android:id="@+id/tvReasonUserDeactivated"
                android:layout_height="wrap_content"
                android:layout_width="300dp"
                android:text="@string/reason_user_deactivated"
                android:layout_below="@id/tvDoctorName"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="50dp"
                android:textSize="30sp"
                />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="#000"
                android:layout_marginBottom="20dp"
                android:padding="10dp"
                android:textSize="30sp"
                android:layout_toRightOf="@id/tvReasonUserDeactivated"
                android:layout_below="@+id/tvDoctorName"
                android:id="@+id/reason_TextInputLayout"
                android:layout_toEndOf="@id/tvReasonUserDeactivated">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReasonUserDeactivated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="true"
                    android:maxLength="50"
                    android:height="100dp"
                    android:textSize="30sp"
                    android:gravity="top"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/colorBlack"
                    android:textColor="#000"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnSend"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/reason_TextInputLayout"
                android:layout_marginStart="660dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_button"
                android:enabled="false"
                android:text="@string/send"
                android:textColor="@color/colorCell"
                android:textSize="30sp" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="260dp"
                android:layout_below="@id/reason_TextInputLayout"
                android:text="@string/cancel"
                android:background="@drawable/rounded_button"
                android:gravity="center"
                android:textSize="30sp"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="10dp"
                 />

        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>