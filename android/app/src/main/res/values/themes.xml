<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="popupTheme">@style/PopupTheme</item>

    </style>

    <style name="PopupTheme" parent="Theme.AppCompat.Light">
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:textColor">@color/colorItem</item>
    </style>


    <style name="Theme.NoTitleBar.WithColoredSpinners" parent="@android:style/Theme.NoTitleBar">
        <item name="android:spinnerItemStyle">@style/SpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/SpinnerItem.DropDownItem</item>
    </style>

    <style name="SpinnerItem" parent="@android:style/Widget.TextView.SpinnerItem">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
    </style>

    <style name="SpinnerItem2" parent="@android:style/Widget.DropDownItem.Spinner">
        <item name="android:textColor">#000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">#FFFFFF</item>
    </style>

    <style name="SpinnerItem.DropDownItem" parent="@android:style/Widget.DropDownItem.Spinner">
        <item name="android:textColor">#000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">#FFFFFF</item>
    </style>

    <style name="MyDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:gravity">center_vertical</item>

    </style>

    <style name="MyDialogTheme240" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">12sp</item>

    </style>

    <style name="MyDialogTheme600" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">20sp</item>

    </style>

    <style name="MyDialogTheme720" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">30sp</item>
        <item name="android:width">200dp</item>
        <item name="android:height">100dp</item>


    </style>


    <style name="MyDialogThemeSize16sp" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:width">1280dp</item>


    </style>
    <style name="MyDialogTheme16sp" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>

    </style>

    <style name="MyDialogTheme18sp" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">18sp</item>

    </style>

    <style name="MyStyle18sp" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textSize">18sp</item>
    </style>


</resources>