<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="30dp"
    android:gravity="center"
    android:background="@color/colorGreen"
    android:layout_gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:layout_gravity="center"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:layout_marginTop="180dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:text="@string/process_purchased_points_manually"
                 />


            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_marginTop="20dp"
                android:inputType="phone"
                android:textSize="16sp"
                android:importantForAutofill="no"
                android:layout_below="@id/tvWelcomeMsg"
                android:textColorHint="@color/colorBlack"
                android:hint="@string/enter_phone_number"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etPaymentType"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapWords"
                android:layout_below="@id/etPhoneNumber"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:hint="@string/enter_type_of_payment"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etTransactionNo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapWords"
                android:layout_below="@id/etPaymentType"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:hint="@string/enter_transaction_number"
                android:layout_alignParentLeft="true" />


            <EditText
                android:id="@+id/etTransactionAmt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etTransactionNo"
                android:layout_marginTop="10dp"
                android:textColorHint="@color/colorBlack"
                android:inputType="numberDecimal"
                android:textSize="16sp"
                android:hint="@string/enter_transaction_amount"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etTypeCurrency"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etTransactionAmt"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textColorHint="@color/colorBlack"
                android:inputType="textCapWords"
                android:hint="@string/enter_type_of_currency"
                android:layout_alignParentLeft="true" />


            <EditText
                android:id="@+id/etPaymentDate"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:backgroundTint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:inputType="date"
                android:longClickable="false"
                android:focusable="false"
                android:layout_below="@id/etTypeCurrency"
                android:hint="@string/enter_date_of_payment"
                android:layout_alignParentLeft="true" />


            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etPaymentDate"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:layout_marginStart="180dp"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:text="@string/cancel"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                 />

            <TextView
                android:id="@+id/tvSendHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etPaymentDate"
                android:layout_marginStart="440dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:enabled="false"
                android:text="@string/send"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textColor="@color/colorCell"
                android:textSize="16sp"
                 />

        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>