<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/colorWhite"
        >


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/type_of_registrattion"
                     />

                <TextView
                    android:id="@+id/tvMainMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="40dp"
                    android:layout_below="@+id/tvWelcomeMsg"
                    android:text="@string/please_select"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="40dp" />


                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:text="@string/individual"
                    android:layout_below="@+id/tvMainMenu"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="40dp"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="40dp"
                    android:layout_alignLeft="@+id/tvWelcomeMsg" />


                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView2"
                    android:layout_below="@+id/textView2"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textColor="@color/colorBlack"
                    android:textStyle="normal"
                    android:text="@string/health_institutions"
                    android:layout_alignLeft="@+id/textView2" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView3"
                    android:layout_below="@+id/textView3"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textColor="@color/colorBlack"
                    android:textStyle="normal"
                    android:text="@string/company"
                    android:layout_alignLeft="@+id/textView3" />


                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView4"
                    android:layout_below="@+id/textView4"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="3dp"
                    android:text="@string/society_group"
                    android:layout_alignLeft="@+id/textView4" />


                <EditText
                    android:id="@+id/etMenuChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView5"
                    android:textSize="12sp"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:ems="20"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="125dp"
                    android:textColor="@color/colorCell"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:enabled="false"
                    android:layout_marginBottom="20dp"
                    android:text="@string/send"
                     />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp"
                    android:textSize="12sp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/colorBlack"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textStyle="normal"
                    android:text="@string/cancel"
                     />


            </RelativeLayout>
        </ScrollView>

    </FrameLayout>
</RelativeLayout>