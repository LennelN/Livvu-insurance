<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/colorGreen"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/colorWhite">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="12dp"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                />

            <EditText
                android:id="@+id/etMenuChoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvWelcomeMsg"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:textStyle="normal"
                android:textAlignment="center"
                android:textColor="@color/colorBlack"
                android:ems="20"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <TextView
                android:id="@+id/tvSendHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etMenuChoice"
                android:layout_marginTop="20dp"
                android:layout_marginStart="190dp"
                android:layout_marginLeft="190dp"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textSize="12sp"
                android:enabled="false"
                android:layout_marginBottom="20dp"
                android:textColor="@color/colorCell"
                android:text="@string/send" />

            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etMenuChoice"
                android:layout_marginStart="30dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/colorBlack"
                android:text="@string/cancel" />


        </RelativeLayout>
    </ScrollView>
    </FrameLayout>
</RelativeLayout>