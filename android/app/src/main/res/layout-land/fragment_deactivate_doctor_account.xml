<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center"
    android:background="@color/colorGreen"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:id="@+id/relativeLayout1"
    >

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/colorWhite"
        >
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_centerHorizontal="true"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorBlack"
                android:text="@string/deactivate_doctor_form"
                 />



<TextView
                android:id="@+id/tvDoctorPhone"
                android:layout_height="wrap_content"
                android:layout_width="130dp"
                android:layout_below="@id/tvWelcomeMsg"
                android:text="@string/select_doctor_phone_no"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="25dp"
                android:textSize="12sp"
                />

            <Spinner
                android:id="@+id/etDoctorPhone"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_below="@id/tvWelcomeMsg"
                android:layout_marginStart="0dp"
                android:layout_marginTop="20dp"
                android:layout_toEndOf="@id/tvDoctorPhone"
                android:backgroundTint="@color/colorBlack"
                android:spinnerMode="dropdown" />


            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/doctors_name"
                android:layout_below="@id/etDoctorPhone"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="12sp"
                />

            <EditText
                android:id="@+id/etDoctorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:enabled="false"
                android:inputType="textCapCharacters"
                android:textSize="12sp"
                android:layout_below="@id/etDoctorPhone"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorName" />


            <TextView
                android:id="@+id/tvReasonUserDeactivated"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/reason_user_deactivated2"
                android:layout_below="@id/tvDoctorName"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="12sp"
                />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="#000"
                android:padding="10dp"
                android:textSize="12sp"
                android:layout_below="@+id/tvDoctorName"
                android:id="@+id/reason_TextInputLayout"
                android:layout_toEndOf="@id/tvReasonUserDeactivated">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReasonUserDeactivated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="true"
                    android:maxLength="50"
                    android:height="100dp"
                    android:textSize="12sp"
                    android:gravity="top"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/colorBlack"
                    android:textColor="#000"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnSend"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/reason_TextInputLayout"
                android:layout_marginStart="190dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/rounded_button"
                android:enabled="false"
                android:text="@string/send"
                android:textColor="@color/colorCell"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_below="@id/reason_TextInputLayout"
                android:text="@string/cancel"
                android:background="@drawable/rounded_button"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                />

        </RelativeLayout>
    </ScrollView>
    </FrameLayout>
</RelativeLayout>