<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/colorGreen"
    >

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/colorWhite"
        >
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/colorBlack"
                    android:layout_centerHorizontal="true"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvMainMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:textSize="12sp"
                    android:layout_marginTop="30dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginStart="40dp"
                    android:layout_below="@+id/tvWelcomeMsg"
                    android:text="@string/please_select"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="40dp" />

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/_1_member_points_reports"
                    android:layout_below="@+id/tvMainMenu"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="40dp"
                    android:layout_alignLeft="@+id/tvWelcomeMsg"
                    android:layout_marginLeft="40dp"
                    android:layout_alignParentLeft="true" />


                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/_2_member_detailed_medical_report"
                    android:layout_below="@+id/textView1"
                    android:layout_alignStart="@+id/textView1"
                    android:layout_marginStart="40dp"
                    android:layout_alignLeft="@+id/textView1"
                    android:layout_marginLeft="40dp"
                    android:layout_alignParentLeft="true" />


                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/_4_member_personal_details"
                    android:layout_below="@+id/textView2"
                    android:layout_alignStart="@+id/textView2"
                    android:layout_marginStart="40dp"
                    android:layout_alignLeft="@+id/textView2"
                    android:layout_marginLeft="40dp"
                    android:layout_alignParentLeft="true" />




                <EditText
                    android:id="@+id/etMenuChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView3"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/colorBlack"
                    android:textColor="@color/colorBlack"
                    android:ems="20"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="190dp"
                    android:layout_marginLeft="190dp"
                    android:textSize="12sp"
                    android:enabled="false"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textColor="@color/colorCell"
                    android:text="@string/send"
                     />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginStart="30dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textStyle="normal"
                    android:textSize="12sp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/cancel"
                     />


            </RelativeLayout>
        </ScrollView>
    </FrameLayout>


</RelativeLayout>