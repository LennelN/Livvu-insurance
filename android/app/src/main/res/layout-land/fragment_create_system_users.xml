<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:text="@string/online_users_registration_form"
                 />


            <EditText
                android:id="@+id/etName"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_marginTop="60dp"
                android:inputType="textCapWords"
                android:textSize="12sp"
                android:textColorHint="@color/colorBlack"
                android:hint="@string/full_name"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapWords"
                android:layout_below="@id/etName"
                android:textSize="12sp"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:hint="@string/physical_address"
                android:layout_alignParentLeft="true" />


            <EditText
                android:id="@+id/etEmailAddress"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textEmailAddress"
                android:textSize="12sp"
                android:layout_below="@id/etAddress"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:hint="@string/email_address"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etIDNo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapWords"
                android:textSize="12sp"
                android:layout_below="@id/etEmailAddress"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:hint="@string/enter_id"
                android:layout_alignParentLeft="true" />


            <TextView
                android:id="@+id/role_id"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/user_role"
                android:backgroundTint="@color/colorBlack"
                android:layout_below="@id/etIDNo"
                android:textColor="@color/colorBlack"
                android:textSize="12sp"
                android:layout_marginTop="15dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:orientation="horizontal"
                android:focusableInTouchMode="true"
                android:focusable="true"
                android:imeOptions="actionNext"
                android:layout_below="@id/etIDNo"
                android:nextFocusDown="@id/etPhoneNumber"
                android:id="@+id/radio"
                android:layout_marginLeft="60dp"
                >


                <RadioButton
                    android:id="@+id/admin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/colorBlack"
                    android:buttonTint="@color/colorBlack"
                    android:textColorHint="@color/colorBlack"
                    android:textColorLink="@color/colorBlack"
                    android:focusable="true"
                    android:checked="true"
                    android:textSize="12sp"
                    android:nextFocusDown="@id/etPhoneNumber"
                    android:text="@string/admin"
                    android:layout_marginStart="30dp"
                    android:layout_marginLeft="30dp" />

                <RadioButton
                    android:id="@+id/accounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/colorBlack"
                    android:buttonTint="@color/colorBlack"
                    android:textColorHint="@color/colorBlack"
                    android:textColorLink="@color/colorBlack"
                    android:focusable="true"
                    android:textSize="12sp"
                    android:nextFocusDown="@id/etPhoneNumber"
                    android:text="@string/accounts"
                    android:layout_marginStart="30dp"
                    android:layout_marginLeft="30dp" />

            </RadioGroup>

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/role_id"
                android:layout_marginTop="20dp"
                android:textColorHint="@color/colorBlack"
                android:inputType="phone"
                android:textSize="12sp"
                android:hint="@string/phone_number"
                android:layout_alignParentLeft="true" />


            <EditText
                android:id="@+id/etPassword"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:text="@string/user_reg_password"
                android:layout_below="@id/etPhoneNumber"
                android:inputType="number"
                android:textSize="12sp"
                android:enabled="false"
                android:hint="@string/password_hint"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_marginTop="10dp"
                android:inputType="number"
                android:layout_below="@id/etPassword"
                android:imeOptions="actionNext"
                android:orientation="horizontal"
                android:enabled="false"
                android:textSize="12sp"
                android:text="@string/user_reg_password"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:nextFocusDown="@id/country_Name"
                android:hint="@string/confirm_password"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etBranch"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapWords"
                android:layout_below="@id/etConfirmPassword"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:hint="@string/enter_user_branch"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etCountry"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:inputType="textCapCharacters"
                android:layout_below="@id/etBranch"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:hint="@string/enter_user_country"
                android:layout_alignParentLeft="true" />



            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etCountry"
                android:layout_marginTop="20dp"
                android:layout_marginStart="30dp"
                android:textSize="12sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:textAlignment="center"
                android:layout_marginBottom="20dp"
                android:background="@drawable/rounded_button"
                android:text="@string/cancel"
                android:layout_marginLeft="30dp" />

            <TextView
                android:id="@+id/tvRegisterHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etCountry"
                android:layout_marginStart="190dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:enabled="false"
                android:text="@string/register"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textColor="@color/colorCell"
                android:textSize="12sp"
                android:layout_marginLeft="190dp" />

        </RelativeLayout>
    </ScrollView>
</RelativeLayout>