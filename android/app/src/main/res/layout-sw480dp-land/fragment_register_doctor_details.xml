<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center"
    android:background="@color/colorGreen"
    android:focusable="true"
    android:padding="30dp"
    android:focusableInTouchMode="true"
    android:id="@+id/relativeLayout1"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/colorWhite"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="220dp"
                android:layout_centerHorizontal="true"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorBlack"
                android:text="@string/medical_doctors_registration_form"
                 />



            <TextView
                android:id="@+id/tvDoctorFirstName"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/enter_name_label"
                android:layout_below="@id/tvWelcomeMsg"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                />

            <EditText
                android:id="@+id/etDoctorFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="textCapWords"
                android:textSize="18sp"
                android:layout_below="@id/tvWelcomeMsg"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorFirstName" />

            <TextView
                android:id="@+id/tvDoctorLastName"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/enter_surname_label"
                android:layout_below="@id/tvDoctorFirstName"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                />

            <EditText
                android:id="@+id/etDoctorLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="textCapWords"
                android:textSize="18sp"
                android:layout_below="@id/tvDoctorFirstName"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorLastName" />


            <TextView
                android:id="@+id/tvDoctorIDNo"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/enter_idno_label"
                android:layout_below="@id/tvDoctorLastName"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                />

            <EditText
                android:id="@+id/etDoctorIDNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="textCapCharacters"
                android:textSize="18sp"
                android:layout_below="@id/tvDoctorLastName"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorIDNo" />


            <TextView
                android:id="@+id/tvDoctorDOB"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/enter_dob_label"
                android:layout_below="@id/tvDoctorIDNo"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                />

            <EditText
                android:id="@+id/etDoctorDOB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="date"
                android:textSize="18sp"
                android:layout_below="@id/tvDoctorIDNo"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorDOB" />

            <TextView
                android:id="@+id/gender_id"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/gender"
                android:backgroundTint="@color/colorBlack"
                android:layout_below="@id/etDoctorDOB"
                android:textColor="@color/colorBlack"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="100dp"
                android:layout_marginEnd="5dp"
                android:orientation="horizontal"
                android:focusableInTouchMode="true"
                android:focusable="true"
                android:imeOptions="actionNext"
                android:layout_below="@id/etDoctorDOB"
                android:textSize="18sp"
                android:nextFocusDown="@id/etPhoneNumber"
                android:id="@+id/radio"
                >

                <RadioButton
                    android:id="@+id/male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusableInTouchMode="true"
                    android:focusable="true"
                    android:nextFocusDown="@id/etPhoneNumber"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/colorBlack"
                    android:buttonTint="@color/colorBlack"
                    android:textColorHint="@color/colorBlack"
                    android:textColorLink="@color/colorBlack"
                    android:checked="true"
                    android:textSize="18sp"
                    android:text="@string/male" />

                <RadioButton
                    android:id="@+id/female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/colorBlack"
                    android:buttonTint="@color/colorBlack"
                    android:textColorHint="@color/colorBlack"
                    android:textColorLink="@color/colorBlack"
                    android:layout_marginStart="20dp"
                    android:focusable="true"
                    android:textSize="18sp"
                    android:nextFocusDown="@id/etPhoneNumber"
                    android:text="@string/female" />

            </RadioGroup>

            <TextView
                android:id="@+id/tvPhoneNumber"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/enter_phoneno_label"
                android:layout_below="@id/gender_id"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                />

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="phone"
                android:textSize="18sp"
                android:layout_below="@id/gender_id"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvPhoneNumber" />

            <TextView
                android:id="@+id/tvDoctorProfession"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/enter_profession_label"
                android:layout_below="@id/etPhoneNumber"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                />

            <EditText
                android:id="@+id/etDoctorProfession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="textCapWords"
                android:textSize="18sp"
                android:layout_below="@id/etPhoneNumber"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorProfession" />

            <TextView
                android:id="@+id/tvDoctorRegNo"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/enter_reg_label"
                android:layout_below="@id/tvDoctorProfession"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                />

            <EditText
                android:id="@+id/etDoctorRegNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="textCapWords"
                android:textSize="18sp"
                android:layout_below="@id/tvDoctorProfession"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvDoctorRegNo" />



            <Button
                android:id="@+id/btnSend"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/etDoctorRegNo"
                android:layout_marginStart="460dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/rounded_button"
                android:enabled="false"
                android:text="@string/send"
                android:textColor="@color/colorCell"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="160dp"
                android:layout_below="@id/etDoctorRegNo"
                android:text="@string/cancel"
                android:background="@drawable/rounded_button"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                />

        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>