<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sBillDate"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="@string/code"
        android:gravity="center_horizontal"
        android:textColor="@color/colorBlack"
        android:layout_marginStart="50dp"
        android:layout_marginLeft="50dp"
        android:padding="3dp"
        android:textSize="18sp"
         />


        <TextView
            android:id = "@+id/sMerchantName"
            android:layout_width = "270dp"
            android:layout_height = "wrap_content"
            android:padding="3dp"
            android:gravity="center_horizontal"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="150dp"
            android:layout_marginLeft="150dp"
            android:text="@string/name"
            android:textSize="18sp"
             />


        <TextView
        android:id = "@+id/sBillNo"
        android:layout_width = "120dp"
        android:layout_height = "wrap_content"
        android:padding="3dp"
        android:gravity="center"
        android:layout_marginStart="420dp"
            android:layout_marginLeft="420dp"
            android:text="@string/bill_no"
        android:textSize="18sp"
            android:textColor="@color/colorBlack"
            />

        <TextView
            android:id = "@+id/sAmount"
            android:layout_width = "120dp"
            android:layout_height = "wrap_content"
            android:gravity="center"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="630dp"
            android:layout_marginLeft="630dp"
            android:text="@string/amount"
            android:textSize="18sp"
             />



    </RelativeLayout>

</LinearLayout>
