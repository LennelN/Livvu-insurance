<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:padding="10dp"
    android:background="@color/colorGreen">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardCornerRadius="20dp">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:background="@color/colorWhite"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    >

                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_centerHorizontal="true"
                    android:textColor="@color/colorBlack"
                     />

                <TextView
                    android:id="@+id/tvMainMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:textSize="16sp"
                    android:layout_marginTop="90dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginStart="10dp"
                    android:layout_below="@+id/tvWelcomeMsg"
                    android:text="@string/please_select"
                     />


                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="30dp"
                    android:textSize="16sp"
                    android:layout_alignParentStart="true"
                    android:text="@string/trans_points"
                    android:layout_below="@+id/tvMainMenu"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="10dp"
                     />


                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView2"
                    android:layout_below="@+id/textView2"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:textSize="16sp"
                    android:text="@string/create_bill"
                     />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView3"
                    android:layout_below="@+id/textView3"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:textSize="16sp"
                    android:text="@string/cash_out"
                     />


                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView4"
                    android:layout_below="@+id/textView4"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="3dp"
                    android:text="@string/check_balance"
                     />


                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView5"
                    android:layout_below="@+id/textView5"
                    android:textSize="16sp"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/banking_services"
                     />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView6"
                    android:layout_below="@+id/textView6"
                    android:textSize="16sp"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/reports"
                     />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView7"
                    android:layout_below="@+id/textView7"
                    android:textSize="16sp"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/_7_contact_us"
                     />


                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView8"
                    android:layout_below="@+id/textView8"
                    android:textSize="16sp"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/_8_create_system_users"
                     />


                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView9"
                    android:layout_below="@+id/textView9"
                    android:textSize="16sp"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/_9_capture_patient_medical_details"
                     />

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView10"
                    android:layout_below="@+id/textView10"
                    android:textSize="16sp"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/_10_capture_patient_medical_details"
                     />


                <EditText
                    android:id="@+id/etMenuChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView11"
                    android:textSize="16sp"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/colorBlack"
                    android:ems="20"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="160dp"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:layout_marginBottom="30dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textColor="@color/colorCell"
                    android:text="@string/send"
                     />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginStart="20dp"
                    android:textStyle="normal"
                    android:layout_marginTop="20dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="30dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textColor="@color/colorBlack"
                    android:text="@string/logout"
                     />


            </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>
</RelativeLayout>