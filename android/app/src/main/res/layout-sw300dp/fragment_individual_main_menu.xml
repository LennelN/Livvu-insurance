<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGreen"
    android:padding="10dp"
    android:gravity="center"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:background="@color/colorWhite"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            >

                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"
                    android:layout_centerHorizontal="true"
                    android:gravity="center" />

                <TextView
                    android:id = "@+id/textview"
                    android:layout_width = "wrap_content"
                    android:layout_height = "match_parent"
                    android:gravity = "center"
                    android:textStyle = "bold"
                    android:textSize = "16sp"
                    android:textColor="@color/colorBlack"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:layout_below="@id/tvWelcomeMsg"
                    />

                <TextView
                    android:id="@+id/tvMainMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="40dp"
                    android:layout_below="@+id/textview"
                    android:text="@string/please_select"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="40dp" />


                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:text="@string/purchase_points"
                    android:layout_below="@+id/tvMainMenu"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginStart="40dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignLeft="@+id/tvWelcomeMsg"
                    android:layout_marginLeft="40dp" />


                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView2"
                    android:layout_below="@+id/textView2"
                    android:layout_marginTop="3dp"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/transfer_points_year_amount"
                    android:layout_alignLeft="@+id/textView2" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView3"
                    android:layout_below="@+id/textView3"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textSize="16sp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/request_bill_service"
                    android:layout_alignLeft="@+id/textView3" />


                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView4"
                    android:layout_below="@+id/textView4"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/check_balance"
                    android:layout_alignLeft="@+id/textView4" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView5"
                    android:layout_below="@+id/textView5"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/account_statement"
                    android:layout_alignLeft="@+id/textView5" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/textView6"
                    android:layout_below="@+id/textView6"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/_6_contact_us"
                    android:layout_alignLeft="@+id/textView6" />



                <EditText
                    android:id="@+id/etMenuChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView7"
                    android:textSize="16sp"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_marginTop="15dp"
                    android:ems="20"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="160dp"
                    android:textColor="@color/colorBlack"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:text="@string/send"
                    android:layout_marginLeft="160dp" />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:textSize="16sp"
                    android:textColor="@color/colorBlack"
                    android:textStyle="normal"
                    android:text="@string/logout"
                    android:layout_marginLeft="20dp" />


            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        </ScrollView>
</RelativeLayout>