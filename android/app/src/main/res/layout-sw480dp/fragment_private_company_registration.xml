<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGreen"
    android:padding="10dp"
    android:gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:background="@color/colorWhite"
        >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:gravity="center">


        <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:textSize="18sp"
                android:text="@string/welcome_to_phila_registration_form"
                 />


            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginTop="80dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:textSize="18sp"
                android:backgroundTint="@color/colorBlack"
                android:inputType="textCapWords"
                android:hint="@string/company_name"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etLicenceNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@+id/etName"
                android:textColorHint="@color/colorBlack"
                android:inputType="textCapWords"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:hint="@string/company_reg"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_below="@id/etLicenceNo"
                android:textSize="18sp"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:inputType="textCapWords"
                android:hint="@string/comp_desc"
                android:layout_alignParentLeft="true" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:textColorHint="@color/colorBlack"
                android:layout_below="@id/etDescription"
                android:layout_marginTop="10dp"
                android:textSize="18sp"
                android:inputType="textCapWords"
                android:hint="@string/comp_address" />


            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_marginTop="10dp"
                android:layout_below="@id/etAddress"
                android:importantForAutofill="no"
                android:textColorHint="@color/colorBlack"
                android:inputType="phone"
                android:textSize="18sp"
                android:hint="@string/phone_number" />


            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:textSize="18sp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_below="@id/etPhoneNumber"
                android:textColorHint="@color/colorBlack"
                android:layout_marginTop="10dp"
                android:inputType="numberPassword"
                android:hint="@string/password_hint" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_below="@id/etPassword"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:inputType="numberPassword"
                android:textColorHint="@color/colorBlack"
                android:imeOptions="actionNext"
                android:orientation="horizontal"
                android:nextFocusDown="@id/country_Name"
                android:hint="@string/confirm_password" />

            <TextView
                android:id="@+id/select_country"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textColor="@color/colorBlack"
                android:text="@string/select_country"
                android:layout_below="@id/etConfirmPassword"
                android:layout_marginTop="20dp"
                android:textSize="18sp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"/>

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/country_Name"
                android:layout_height="50dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginTop="15dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:spinnerMode="dropdown"
                android:backgroundTint="@color/colorBlack"
                android:layout_below="@id/etConfirmPassword"
                android:layout_toEndOf="@id/select_country"
                android:layout_toRightOf="@id/select_country"
                android:layout_alignParentRight="true" />

            <TextView
                android:id="@+id/etRegion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_below="@id/country_Name"
                android:layout_marginTop="20dp"
                android:textSize="18sp"
                android:textColor="@color/colorBlack"
                android:text="@string/comp_region" />

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/region_desc"
                android:layout_height="50dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginTop="15dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:spinnerMode="dropdown"
                android:backgroundTint="@color/colorBlack"
                android:imeOptions="actionNext"
                android:orientation="horizontal"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_below="@id/country_Name"
                android:layout_toEndOf="@id/etRegion"
                android:layout_toRightOf="@id/etRegion"
                android:layout_alignParentRight="true" />


            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/region_desc"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="20dp"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:layout_marginStart="60dp"
                android:textSize="18sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:text="@string/cancel"
                android:layout_marginLeft="60dp" />

            <TextView
                android:id="@+id/tvRegisterHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/region_desc"
                android:layout_marginStart="280dp"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="20dp"
                android:textColor="@color/colorCell"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:textSize="18sp"
                android:enabled="false"
                android:text="@string/register"
                android:layout_marginLeft="280dp" />
        </RelativeLayout>
    </ScrollView>
    </FrameLayout>
</RelativeLayout>