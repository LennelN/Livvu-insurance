<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

    <TextView
        android:id = "@+id/sBillDate"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:layout_marginStart="0dp"
        android:padding="1dp"
        android:text="@string/date"
        android:textSize="18sp"
        android:textColor="@color/colorBlack"
        android:layout_marginLeft="0dp"
         />

    <TextView
        android:id = "@+id/sMerchantName"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:layout_marginStart="100dp"
        android:textColor="@color/colorBlack"
        android:padding="1dp"
        android:textSize="18sp"
        android:text="@string/phone"
        android:layout_marginLeft="100dp"
         />


        <TextView
            android:id = "@+id/totalPrice"
            android:layout_width = "90dp"
            android:layout_height = "match_parent"
            android:layout_marginStart="210dp"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:text="@string/bill_no"
            android:textSize="18sp"
            android:layout_marginLeft="210dp" />

    <TextView
        android:id = "@+id/noOfPoints"
        android:layout_width = "90dp"
        android:layout_height = "match_parent"
        android:padding="3dp"
        android:layout_marginStart="300dp"
        android:textColor="@color/colorBlack"
        android:text="@string/points"
        android:textSize="18sp"
        android:layout_marginLeft="300dp" />

        <TextView
            android:id = "@+id/noOfDays"
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:padding="3dp"
            android:textColor="@color/colorBlack"
            android:layout_marginStart="390dp"
            android:text="@string/no_of_days"
            android:textSize="18sp"
            android:layout_marginLeft="390dp" />



    </RelativeLayout>

</LinearLayout>
