<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

        <TextView
            android:id = "@+id/sBillDate"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:text="@string/date"
            android:layout_marginStart="0dp"
            android:padding="1dp"
            android:textSize="18sp"
            android:textColor="@color/colorBlack"
            android:layout_marginLeft="0dp" />

        <TextView
            android:id = "@+id/sCode"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:text="@string/type"
            android:textSize="18sp"
            android:textColor="@color/colorBlack"
            android:padding="1dp"
            android:layout_marginStart="100dp"
            android:layout_marginLeft="100dp" />

        <TextView
            android:id = "@+id/sMerchantName"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:text="@string/ph_no"
            android:layout_marginStart="190dp"
            android:textColor="@color/colorBlack"
            android:padding="2dp"
            android:textSize="18sp"
            android:layout_marginLeft="190dp" />


        <TextView
            android:id = "@+id/noOfPoints"
            android:layout_width = "90dp"
            android:layout_height = "wrap_content"
            android:layout_marginStart="295dp"
            android:padding="2dp"
            android:textColor="@color/colorBlack"
            android:textAlignment="center"
            android:textSize="18sp"
            android:text="@string/debit"
            android:layout_marginLeft="295dp" />

        <TextView
            android:id = "@+id/noOfPointsPaid"
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:padding="3dp"
            android:layout_marginStart="385dp"
            android:textAlignment="center"
            android:textColor="@color/colorBlack"
            android:hint="@string/credit"
            android:textSize="18sp"
            android:layout_marginLeft="385dp" />




    </RelativeLayout>

</LinearLayout>
