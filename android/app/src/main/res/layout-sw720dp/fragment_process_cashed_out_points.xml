<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="50dp"
    android:background="@color/colorGreen"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:layout_gravity="center"
            android:gravity="center">

                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="40dp"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:text="@string/process_cashed_out_points_form"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"
                    android:layout_centerHorizontal="true"
                    />

                <TextView
                    android:id="@+id/tvCashOutTransNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:layout_below="@id/tvWelcomeMsg"
                    android:text="@string/cashed_out_number"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"
                    android:layout_centerHorizontal="true"
                    />


            <TextView
                android:id="@+id/tvCashOutTransAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="30sp"
                android:gravity="center"
                android:layout_below="@id/tvCashOutTransNo"
                android:text="@string/cashed_out_number"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:layout_centerHorizontal="true"
                />


            <EditText
                android:id="@+id/etTransactionNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvCashOutTransAmount"
                    android:textSize="30sp"
                    android:layout_marginTop="20dp"
                    android:textStyle="normal"
                    android:hint="@string/enter_transaction_number"
                    android:backgroundTint="@color/colorBlack"
                    android:textColor="@color/colorBlack"
                    android:textColorHint="@color/colorBlack"
                    android:inputType="textCapWords" />


                <EditText
                    android:id="@+id/etTransactionType"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textColorHint="@color/colorBlack"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:layout_below="@id/etTransactionNo"
                    android:inputType="textCapWords"
                    android:textSize="30sp"
                    android:hint="@string/enter_transaction_type"
                    android:layout_alignParentLeft="true" />

                <EditText
                    android:id="@+id/etTransactionAmt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:inputType="numberDecimal"
                    android:layout_below="@id/etTransactionType"
                    android:imeOptions="actionNext"
                    android:orientation="horizontal"
                    android:textSize="30sp"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:nextFocusDown="@id/country_Name"
                    android:hint="@string/enter_transaction_amount"
                    android:layout_alignParentLeft="true" />

                <EditText
                    android:id="@+id/etTransactionDate"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:inputType="date"
                    android:layout_below="@id/etTransactionAmt"
                    android:imeOptions="actionNext"
                    android:orientation="horizontal"
                    android:longClickable="false"
                    android:focusable="false"
                    android:textSize="30sp"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:nextFocusDown="@id/country_Name"
                    android:hint="@string/enter_transaction_date"
                    android:layout_alignParentLeft="true" />



                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etTransactionDate"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="420dp"
                    android:layout_marginBottom="40dp"
                    android:textSize="30sp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textColor="@color/colorCell"
                    android:enabled="false"
                    android:text="@string/send" />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etTransactionDate"
                    android:layout_marginStart="120dp"
                    android:layout_marginBottom="40dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:layout_marginTop="40dp"
                    android:textSize="30sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/cancel" />


            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        </ScrollView>
</RelativeLayout>