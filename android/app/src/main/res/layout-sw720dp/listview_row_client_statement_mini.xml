<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

        <TextView
            android:id = "@+id/sBillDate"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:text="@string/date"
            android:layout_marginStart="0dp"
            android:padding="1dp"
            android:textSize="30sp"
            android:textColor="@color/colorBlack"
            android:layout_marginLeft="0dp" />

        <TextView
            android:id = "@+id/sCode"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:text="@string/type"
            android:textSize="30sp"
            android:textColor="@color/colorBlack"
            android:padding="1dp"
            android:layout_marginStart="160dp"
            android:layout_marginLeft="160dp" />

        <TextView
            android:id = "@+id/sMerchantName"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:text="@string/ph_no"
            android:layout_marginStart="300dp"
            android:textColor="@color/colorBlack"
            android:padding="1dp"
            android:textSize="30sp"
            android:layout_marginLeft="300dp" />


        <TextView
            android:id = "@+id/noOfPoints"
            android:layout_width = "150dp"
            android:layout_height = "wrap_content"
            android:layout_marginStart="480dp"
            android:padding="1dp"
            android:textColor="@color/colorBlack"
            android:textAlignment="center"
            android:textSize="30sp"
            android:text="@string/debit"
            android:layout_marginLeft="480dp" />

        <TextView
            android:id = "@+id/noOfPointsPaid"
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:padding="1dp"
            android:layout_marginStart="630dp"
            android:textAlignment="center"
            android:textColor="@color/colorBlack"
            android:hint="@string/credit"
            android:textSize="30sp"
            android:layout_marginLeft="630dp" />




    </RelativeLayout>

</LinearLayout>
