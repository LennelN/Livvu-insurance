<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGreen"
    android:gravity="center"
    android:padding="50dp"
    android:layout_gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="50dp"
            android:background="@color/colorWhite"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:layout_marginTop="100dp"
                android:layout_marginBottom="20dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:text="@string/select_continent"
                 />



            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/continent_Name"
                android:layout_height="100dp"
                android:layout_marginTop="30dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:backgroundTint="@color/colorBlack"
                android:spinnerMode="dropdown"
                android:layout_below="@id/tvWelcomeMsg"
                android:layout_marginLeft="10dp"

                />



            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/continent_Name"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="50dp"
                android:layout_marginStart="60dp"
                android:textSize="30sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:text="@string/cancel"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                 />

            <TextView
                android:id="@+id/tvSendHere"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/continent_Name"
                android:layout_marginStart="380dp"
                android:layout_marginTop="50dp"
                android:text="@string/send"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:layout_marginBottom="50dp"
                android:textColor="@color/colorBlack"
                android:textSize="30sp"
                 />

        </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>