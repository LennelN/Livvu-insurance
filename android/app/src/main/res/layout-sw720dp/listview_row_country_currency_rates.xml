<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/relativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background = "@color/colorWhite">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/relative1">

        <TextView
            android:id = "@+id/sRegion"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:gravity="center_horizontal"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:textSize="30sp"
            android:text="Test Couunty"
            android:layout_marginLeft="0dp"
            />

        <TextView
            android:id = "@+id/sCountry"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_marginStart="200dp"
            android:gravity="center_horizontal"
            android:textColor="@color/colorBlack"
            android:padding="3dp"
            android:text="ZWL"
            android:textSize="30sp"
            android:layout_marginLeft="200dp"
            />


    <TextView
        android:id = "@+id/sCategory"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:layout_marginStart="400dp"
        android:gravity="center_horizontal"
        android:textColor="@color/colorBlack"
        android:padding="3dp"
        android:text="200"
        android:textSize="30sp"
        android:layout_marginLeft="420dp"
        />

    <TextView
        android:id = "@+id/sNo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:textColor="@color/colorBlack"
        android:layout_marginStart="560dp"
        android:padding="3dp"
        android:textSize="30sp"
        android:text="TestCountry"
        android:gravity="center_horizontal"
        android:layout_marginLeft="620dp"
        />


    </RelativeLayout>

</LinearLayout>
