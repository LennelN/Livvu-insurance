<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:padding="50dp"
    android:background="@color/colorGreen">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                app:cardCornerRadius="20dp">


            <RelativeLayout
                android:layout_width="match_parent"
                android:background="@color/colorWhite"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                >
                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="30dp"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:text="@string/reset_password_form"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"
                    android:layout_centerHorizontal="true"
                    />


                <EditText
                    android:id="@+id/etUserPwd"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textColorHint="@color/colorBlack"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_marginTop="30dp"
                    android:textSize="30sp"
                    android:maxLength="4"
                    android:layout_below="@id/tvWelcomeMsg"
                    android:inputType="numberPassword"
                    android:hint="@string/password_hint"
                    android:layout_alignParentLeft="true" />

                <EditText
                    android:id="@+id/etConfirmUserPwd"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:inputType="numberPassword"
                    android:layout_below="@id/etUserPwd"
                    android:imeOptions="actionNext"
                    android:textSize="30sp"
                    android:maxLength="4"
                    android:orientation="horizontal"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:nextFocusDown="@id/country_Name"
                    android:hint="@string/confirm_password"
                    android:layout_alignParentLeft="true" />


                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etConfirmUserPwd"
                    android:layout_marginTop="50dp"
                    android:layout_marginStart="380dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:layout_marginLeft="380dp"
                    android:layout_marginBottom="50dp"
                    android:textSize="30sp"
                    android:textColor="@color/colorCell"
                    android:enabled="false"
                    android:text="@string/send" />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etConfirmUserPwd"
                    android:layout_marginStart="80dp"
                    android:layout_marginLeft="80dp"
                    android:layout_marginBottom="50dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:layout_marginTop="50dp"
                    android:textSize="30sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/cancel" />


            </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>
</RelativeLayout>