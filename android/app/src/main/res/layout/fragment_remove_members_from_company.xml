<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGreen"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="@color/colorWhite"
        >


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_centerHorizontal="true"
                android:textSize="12sp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:text="@string/remove_member_phone_numbers"
                />


            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:backgroundTint="@color/colorBlack"
                android:inputType="phone"
                android:textSize="12sp"
                android:textColorHint="@color/colorBlack"
                android:textAlignment="center"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="50dp"
                android:importantForAutofill="no"
                android:hint="@string/enter_phone_number"
                />

            <TextView
                android:id="@+id/select_country"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/select_country"
                android:textColor="@color/colorBlack"
                android:layout_below="@id/etPhone"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:layout_alignParentStart="true"
                />

            <Spinner
                android:layout_width="match_parent"
                android:id="@+id/country_Name"
                android:layout_height="30dp"
                android:layout_marginTop="0dp"
                android:layout_marginStart="20dp"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/colorBlack"
                android:spinnerMode="dropdown"
                android:layout_below="@id/etPhone"
                android:layout_toEndOf="@id/select_country"
                />



            <Button
                android:id="@+id/add_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_below="@id/country_Name"
                android:textAlignment="center"
                android:textColor="@color/colorBlack"
                android:background="@drawable/rounded_button"
                android:text="@string/add"
                android:textSize="12sp"
                android:enabled="false"
                 />


            <LinearLayout
                android:id="@+id/ly_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorAccent"
                android:layout_below="@id/add_phone">
                <include layout="@layout/listview_header_members"/>
            </LinearLayout>

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:layout_below="@id/ly_header"
                >
            </ListView>


        </RelativeLayout>


    </FrameLayout>
</RelativeLayout>