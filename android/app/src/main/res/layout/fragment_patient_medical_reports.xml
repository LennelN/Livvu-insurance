<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_marginTop="0dp"
        android:layout_gravity="center"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@color/colorWhite"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@color/colorWhite"
                android:orientation="vertical"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:layout_marginTop="160dp"
                    android:text="@string/please_select"
                    android:textColor="#000"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:id="@+id/heading"/>

                <CheckBox android:id="@+id/phoneNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginTop="10dp"
                    android:textColor="#000"
                    android:focusable="false"
                    android:clickable="false"
                    android:textSize="12sp"
                    android:textColorHint="@color/colorBlack"
                    android:text="@string/report_by_phone_number" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edtUserName"
                    android:backgroundTint="@color/colorBlack"
                    android:hint="@string/enter_phone_number"
                    android:textColor="#000"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:textColorHint="@color/colorBlack"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvSelectCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/colorBlack"
                    android:text="@string/select_country"
                    />



                <Spinner
                    android:layout_width="match_parent"
                    android:id="@+id/country_Name"
                    android:layout_height="30dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/colorBlack"
                    android:spinnerMode="dropdown"


                    />


                <CheckBox android:id="@+id/dateRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/colorBlack"
                    android:textColor="#000"
                    android:textSize="12sp"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:buttonTint="@color/colorBlack"
                    android:textColorHighlight="@color/colorBlack"
                    android:text="@string/report_by_date_range" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvStartDate"
                        android:textColor="@color/colorBlack"
                        android:enabled="true"
                        android:hint="@string/enter_start_date_report"
                        android:textColorHint="@color/colorBlack"
                        android:paddingRight="5dp"
                        android:paddingLeft="5dp"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="@string/to_report"
                        android:gravity="center"
                        android:id="@+id/to_date"
                        android:paddingRight="5dp"
                        android:textColorHint="@color/colorBlack"
                        android:paddingLeft="5dp"
                        android:textColor="@color/colorBlack"
                        android:enabled="true"
                        android:textSize="12sp"/>


                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvEndDate"
                        android:paddingRight="0dp"
                        android:paddingLeft="0dp"
                        android:textColorHint="@color/colorBlack"
                        android:hint="@string/enter_end_date_report"
                        android:textColor="@color/colorBlack"
                        android:enabled="true"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/action_cancel"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/rounded_button"
                    android:text="@string/cancel"
                    android:textAlignment="center"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ok"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:layout_marginTop="30dp"
                    android:textSize="12sp"
                    android:layout_marginStart="20dp"
                    android:textColor="@color/colorBlack"
                    android:layout_marginBottom="20dp"
                    android:id="@+id/action_ok"
                    android:layout_marginLeft="20dp" />



            </LinearLayout>

        </LinearLayout>


    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
