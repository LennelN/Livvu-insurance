<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/colorWhite"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"
                    android:text="@string/welcome_to_phila_registration_form"
                     />


                <EditText
                    android:id="@+id/etName"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="60dp"
                    android:inputType="textCapWords"
                    android:textColorHint="@color/colorBlack"
                    android:hint="@string/name"
                    android:textSize="12sp"
                    android:layout_alignParentLeft="true" />

                <EditText
                    android:id="@+id/etSurname"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:inputType="textCapWords"
                    android:layout_below="@id/etName"
                    android:textColorHint="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:hint="@string/surname"
                    android:textSize="12sp"
                    android:layout_alignParentLeft="true" />

                <EditText
                    android:id="@+id/etIDNo"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:inputType="textCapWords"
                    android:layout_below="@id/etSurname"
                    android:textSize="12sp"
                    android:textColorHint="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:hint="@string/enter_id"
                    android:layout_alignParentLeft="true" />


                <EditText
                    android:id="@+id/etDob"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:layout_below="@id/etIDNo"
                    android:layout_marginTop="10dp"
                    android:textColorHint="@color/colorBlack"
                    android:inputType="date"
                    android:hint="@string/dob"
                    android:layout_alignParentLeft="true" />

                <TextView
                    android:id="@+id/gender_id"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="@string/gender"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_below="@id/etDob"
                    android:textColor="@color/colorBlack"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true" />

                <RadioGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="5dp"
                    android:orientation="horizontal"
                    android:focusableInTouchMode="true"
                    android:focusable="true"
                    android:imeOptions="actionNext"
                    android:layout_below="@id/etDob"
                    android:textSize="12sp"
                    android:nextFocusDown="@id/etPhoneNumber"
                    android:id="@+id/radio"
                    android:layout_marginLeft="170dp"
                    android:layout_marginRight="5dp">

                    <RadioButton
                        android:id="@+id/male"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusableInTouchMode="true"
                        android:focusable="true"
                        android:nextFocusDown="@id/etPhoneNumber"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/colorBlack"
                        android:buttonTint="@color/colorBlack"
                        android:textColorHint="@color/colorBlack"
                        android:textColorLink="@color/colorBlack"
                        android:checked="true"
                        android:textSize="12sp"
                        android:text="@string/male" />

                    <RadioButton
                        android:id="@+id/female"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:focusableInTouchMode="true"
                        android:textColor="@color/colorBlack"
                        android:buttonTint="@color/colorBlack"
                        android:textColorHint="@color/colorBlack"
                        android:textColorLink="@color/colorBlack"
                        android:focusable="true"
                        android:textSize="12sp"
                        android:nextFocusDown="@id/etPhoneNumber"
                        android:text="@string/female" />

                </RadioGroup>

                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:layout_below="@id/gender_id"
                    android:layout_marginTop="10dp"
                    android:textColorHint="@color/colorBlack"
                    android:inputType="phone"
                    android:textSize="12sp"
                    android:importantForAutofill="no"
                    android:hint="@string/phone_number"
                    android:layout_alignParentLeft="true" />


                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textColorHint="@color/colorBlack"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    android:layout_below="@id/etPhoneNumber"
                    android:inputType="numberPassword"
                    android:hint="@string/password_hint"
                    android:layout_alignParentLeft="true" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/colorBlack"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:inputType="numberPassword"
                    android:layout_below="@id/etPassword"
                    android:imeOptions="actionNext"
                    android:textSize="12sp"
                    android:orientation="horizontal"
                    android:textColor="@color/colorBlack"
                    android:backgroundTint="@color/colorBlack"
                    android:nextFocusDown="@id/country_Name"
                    android:hint="@string/confirm_password"
                    android:layout_alignParentLeft="true" />

                <TextView
                    android:id="@+id/select_country"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="@string/select_country"
                    android:textColor="@color/colorBlack"
                    android:layout_below="@id/etConfirmPassword"
                    android:layout_marginTop="15dp"
                    android:textSize="12sp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true" />

                <Spinner
                    android:layout_width="match_parent"
                    android:id="@+id/country_Name"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_alignParentEnd="true"
                    android:backgroundTint="@color/colorBlack"
                    android:spinnerMode="dropdown"
                    android:layout_below="@id/etConfirmPassword"
                    android:layout_toEndOf="@id/select_country"
                    android:layout_marginLeft="10dp"
                    android:layout_alignParentRight="true"
                    android:layout_toRightOf="@id/select_country" />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/country_Name"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="10dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textSize="12sp"
                    android:textColor="@color/colorBlack"
                    android:textStyle="normal"
                    android:layout_marginBottom="20dp"
                    android:text="@string/cancel"
                    android:layout_marginLeft="10dp" />

                <TextView
                    android:id="@+id/tvRegisterHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/country_Name"
                    android:layout_marginStart="125dp"
                    android:layout_marginTop="20dp"
                    android:enabled="false"
                    android:textAlignment="center"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/rounded_button"
                    android:text="@string/register"
                    android:textColor="@color/colorCell"
                    android:textSize="12sp"
                    android:layout_marginLeft="125dp" />

            </RelativeLayout>
        </ScrollView>
</RelativeLayout>