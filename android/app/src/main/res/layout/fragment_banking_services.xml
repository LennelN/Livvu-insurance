<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGreen"
    android:gravity="center"
    tools:context=".BankingServicesFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/colorWhite"
        >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvWelcomeMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="12dp"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"
                    />

                <TextView
                    android:id="@+id/tvMainMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_marginTop="40dp"
                    android:layout_marginLeft="40dp"
                    android:layout_marginStart="40dp"
                    android:layout_below="@+id/tvWelcomeMsg"
                    android:text="@string/please_select" />


                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="33dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:text="@string/enter_banking_details"
                    android:layout_below="@+id/tvMainMenu"
                    android:layout_alignLeft="@+id/tvWelcomeMsg"
                    android:layout_alignStart="@+id/tvWelcomeMsg"
                    android:layout_marginLeft="40dp"
                    android:layout_marginStart="40dp"/>


                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignLeft="@+id/textView2"
                    android:layout_alignStart="@+id/textView2"
                    android:layout_below="@+id/textView2"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/reconcile" />



                <EditText
                    android:id="@+id/etMenuChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView3"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp"
                    android:ems="20"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/tvSendHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="125dp"
                    android:layout_marginLeft="125dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:textSize="12sp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/colorCell"
                    android:enabled="false"
                    android:text="@string/send" />

                <TextView
                    android:id="@+id/tvCancelHere"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etMenuChoice"
                    android:layout_marginStart="10dp"
                    android:layout_marginLeft="10dp"
                    android:textAlignment="center"
                    android:background="@drawable/rounded_button"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/colorBlack"
                    android:text="@string/cancel" />


            </RelativeLayout>
        </ScrollView>
    </FrameLayout>


</RelativeLayout>