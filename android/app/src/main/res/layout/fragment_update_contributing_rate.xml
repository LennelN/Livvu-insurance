<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGreen"
    android:gravity="center"
    android:layout_gravity="center"
    >

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@color/colorWhite"
            android:gravity="center">


            <TextView
                android:id="@+id/tvWelcomeMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_centerHorizontal="true"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorBlack"
                android:text="@string/update_country_contributing_form"
                />


            <TextView
                android:id="@+id/tvCurrencyCode"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/country"
                android:layout_below="@id/tvWelcomeMsg"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="20dp"
                android:textSize="12sp"
                />

            <EditText
                android:id="@+id/etCurrencyCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:textSize="12sp"
                android:layout_toRightOf="@id/tvCurrencyCode"
                android:layout_below="@id/tvWelcomeMsg"
                android:layout_alignParentRight="true"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_marginLeft="130dp"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvCurrencyCode" />


            <TextView
                android:id="@+id/tvCurrencyAmount"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/amount"
                android:layout_below="@id/tvCurrencyCode"
                android:textColor="@color/colorBlack"
                android:layout_marginTop="40dp"
                android:textSize="12sp"
                />

            <EditText
                android:id="@+id/etCurrencyAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:layout_toRightOf="@id/tvCurrencyAmount"
                android:layout_below="@id/etCurrencyCode"
                android:layout_alignParentRight="true"
                android:layout_marginTop="20dp"
                android:textSize="12sp"
                android:layout_marginStart="10dp"
                android:textColorHint="@color/colorBlack"
                android:textColor="@color/colorBlack"
                android:backgroundTint="@color/colorBlack"
                android:layout_marginLeft="130dp"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/tvCurrencyAmount" />

            <EditText
                android:id="@+id/etNoOfDigits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etCurrencyAmount"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="0dp"
                android:backgroundTint="@color/colorBlack"
                android:gravity="center"
                android:inputType="number"
                android:textColor="@color/colorBlack"
                android:textColorHint="@color/colorBlack"
                android:textSize="30sp"
                android:visibility="invisible" />


            <TextView
                android:id="@+id/tvCancelHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etNoOfDigits"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="10dp"
                android:textSize="12sp"
                android:textColor="@color/colorBlack"
                android:textStyle="normal"
                android:text="@string/cancel"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:layout_marginLeft="10dp" />

            <TextView
                android:id="@+id/tvSendHere"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etNoOfDigits"
                android:layout_marginStart="125dp"
                android:layout_marginTop="20dp"
                android:text="@string/update"
                android:textAlignment="center"
                android:background="@drawable/rounded_button"
                android:layout_marginBottom="20dp"
                android:textColor="@color/colorBlack"
                android:textSize="12sp"
                android:layout_marginLeft="125dp" />

        </RelativeLayout>
    </ScrollView>
</RelativeLayout>